rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isBoundedString(value, minLen, maxLen) {
      return value is string
        && value.size() >= minLen
        && value.size() <= maxLen;
    }

    function isValidMembersList(value) {
      return value is list && value.size() > 0 && value.size() <= 64;
    }

    function isValidItemsValue(value) {
      return (value is map && value.keys().size() <= 5000)
        || (value is list && value.size() <= 5000);
    }

    function isValidListDoc(data) {
      return data.keys().hasOnly(["name", "members", "items"])
        && data.keys().hasAll(["name", "members", "items"])
        && isBoundedString(data.name, 1, 120)
        && isValidMembersList(data.members)
        && isValidItemsValue(data.items);
    }

    function isValidUserDoc(data) {
      return data.keys().hasOnly(["email", "name", "updatedAt"])
        && data.keys().hasAll(["email", "name"])
        && isBoundedString(data.email, 3, 320)
        && isBoundedString(data.name, 1, 120)
        && (!("updatedAt" in data) || data.updatedAt is number);
    }

    function isValidCatalogDoc(data) {
      return data.keys().hasOnly(["entries"])
        && ("entries" in data)
        && (
          (data.entries is list && data.entries.size() <= 5000)
          || (data.entries is map && data.entries.keys().size() <= 5000)
        );
    }

    // lists/{listId}
    match /lists/{listId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidListDoc(request.resource.data);
      allow update: if isSignedIn() && isValidListDoc(request.resource.data);
      allow delete: if isSignedIn();
    }

    // users/{encodedEmail}
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidUserDoc(request.resource.data);
      allow update: if isSignedIn()
        && isValidUserDoc(request.resource.data)
        && ("email" in resource.data)
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // shopping/catalog
    match /shopping/{docId} {
      allow read: if isSignedIn() && docId == "catalog";
      allow create: if isSignedIn() && docId == "catalog" && isValidCatalogDoc(request.resource.data);
      allow update: if isSignedIn() && docId == "catalog" && isValidCatalogDoc(request.resource.data);
      allow delete: if false;
    }

    // Deny any other path by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
